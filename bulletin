<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>WSEC League Bulletin Archive</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      margin: 0;
      padding: 20px;
    }

    .wrap {
      max-width: 900px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    h1 {
      margin-top: 0;
    }

    .bulletin {
      border-left: 4px solid #c99700;
      background: #fffaf0;
      padding: 15px 18px;
      margin-bottom: 15px;
      border-radius: 8px;
    }

    .date {
      font-weight: bold;
      color: #333;
    }

    .title {
      font-weight: bold;
      margin: 5px 0 10px;
      color: #c99700;
    }

    p {
      margin: 6px 0;
      line-height: 1.5;
    }

    a {
      color: #1a73e8;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .back {
      margin-top: 20px;
      display: inline-block;
    }
  </style>
</head>

<body>

<div class="wrap">

  <h1>WSEC League Bulletin Archive</h1>

  <div id="bulletinContainer">Loading bulletins...</div>

  <a class="back" href="./index.html">← Back to leaderboard</a>

</div>

<script src="bulletin-data.js"></script>

<script>
function renderAllBulletins() {

  if (!window.bulletins || !Array.isArray(bulletins)) {
    document.getElementById("bulletinContainer").innerHTML =
      "No bulletins available.";
    return;
  }

  let html = "";

  // newest first
  const sorted = [...bulletins].sort((a, b) => {
    return new Date(b.date) - new Date(a.date);
  });

  sorted.forEach(b => {

    html += `
      <div class="bulletin">
        <div class="date">${b.date}</div>
        <div class="title">${b.title}</div>
    `;

    b.content.forEach(p => {
      html += `<p>${p}</p>`;
    });

    html += `</div>`;
  });

  document.getElementById("bulletinContainer").innerHTML = html;
}

renderAllBulletins();
</script>

</body>
</html>
